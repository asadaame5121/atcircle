{
    "lexicon": 1,
    "id": "net.asadaame5121.at-circle.decision",
    "defs": {
        "main": {
            "type": "record",
            "description": "A circle administrator's decision about one membership (a member or request record). Only decisions written by the circle owner or the circle's admin are honoured.",
            "key": "tid",
            "record": {
                "type": "object",
                "required": [
                    "ring",
                    "subject",
                    "status",
                    "createdAt"
                ],
                "properties": {
                    "ring": {
                        "type": "ref",
                        "ref": "net.asadaame5121.at-circle.defs#ringRef"
                    },
                    "subject": {
                        "type": "ref",
                        "ref": "com.atproto.repo.strongRef",
                        "description": "The member or request record this decision applies to"
                    },
                    "status": {
                        "type": "string",
                        "knownValues": [
                            "approved",
                            "suspended",
                            "removed"
                        ],
                        "maxLength": 100,
                        "description": "approved: listed in the circle. suspended: temporarily hidden. removed: kicked (the member may join again with a new record)."
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "datetime"
                    }
                }
            }
        }
    }
}
